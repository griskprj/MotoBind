FRONTEND_URL=http://localhost:5173/
SECRET_KEY=super-strong-and-long-secret-SECRET_KEY
JWT_SECRET_KEY=super-secret-and-strong-jwt-secret-key
SQLALCHEMY_DATABASE_URI=sqlite:///database.db
ENV=development

MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=example@yandex.ru
MAIL_PASSWORD=password
MAIL_DEFAULT_SENDER=example@yandex.ru

CRON_SECRET=вставьте_сюда_длинную_случайную_строку
ENABLE_DEV_SCHEDULER=false

# Robokassa: use test credentials while ROBOKASSA_TEST_MODE=true.
ROBOKASSA_MERCHANT_LOGIN=motobind
ROBOKASSA_HASH_ALGORITHM=MD5
ROBOKASSA_TEST_MODE=true
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_PAYMENT_OBJECT=service
ROBOKASSA_PAYMENT_METHOD=full_payment
ROBOKASSA_TAX=none

# Web Push: generate VAPID keys once and keep the private key outside the repository.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=/etc/motobind/vapid_private.pem
WEBPUSH_VAPID_SUBJECT=mailto:motobind@yandex.ru
